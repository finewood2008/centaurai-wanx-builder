+def native_package_file(path: str, roots: list[Path], workspace: Path) -> Path | None:
+    """Match a native package file, or its unmodified private workspace copy."""
+    skills = workspace / ".octop" / "skills"
+    if not skills.is_dir():
+        skills = workspace / "skills"
+    if path.startswith(("skills/", "/skills/")):
+        path = str(skills / path.lstrip("/").removeprefix("skills/"))
+    elif path.startswith("/.octop/skills/"):
+        path = str(workspace / path.lstrip("/"))
+    file = Path(path)
+    file = file if file.is_absolute() else workspace / file
+    try:
+        file = file.resolve()
+        if not file.is_file():
+            return None
+        for root in roots:
+            root = root.resolve()
+            if file.is_relative_to(root):
+                return file
+        relative = file.relative_to(skills.resolve())
+        for root in roots:
+            original = (root / relative).resolve()
+            if (
+                original.is_relative_to(root.resolve())
+                and original.is_file()
+                and original.read_bytes() == file.read_bytes()
+            ):
+                return original
+    except (OSError, ValueError):
+        pass
+    return None
+
